# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# ---------- 环境变量 / 密钥（务必不要提交）----------
.env
.env.*
!.env.example
# web/ 的两份是**公共默认值**（只有 VITE_USE_MOCK / VITE_API_BASE 这类，没有任何密钥），
# 必须提交：`.env.*` 会连它们一起忽略，而 `web/src/config/env.ts` 的 mock 开关
# 一旦读不到 .env.production，构建出来的前端就全是内置演示数据 ——
# 界面看起来完全正常，只有 clone 的人才会发现没有一条是真数据。
!web/.env.development
!web/.env.production

# ---------- 运行期数据：索引 / SQLite / checkpoint（体积大，且可重建）----------
data/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# ---------- 模型权重与缓存 ----------
.cache/
.cache_hf/
models/

# ---------- 样例数据：允许提交小体积 json，排除预建索引等大文件 ----------
sample_data/*
!sample_data/.gitkeep
!sample_data/*.json

# ---------- 日志 ----------
*.log
logs/

# ---------- 测试 / 工具缓存 ----------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/

# ---------- 抽检 CSV：从本地库抽样的机器相关产物，不入库 ----------
# 人工判定完成后若想作为证据提交，另存为 *_labeled.csv（下面这行放行它）
eval_results/citation_spotcheck.csv
!eval_results/citation_spotcheck_labeled.csv

# ---------- 消融报告的重新生成产物 ----------
# README 只登记两份报告；`make eval-ablation` 每次都会覆写 ablation_latest.md，
# 它的索引/查询口径与那两份不同轮，留在工作区里只会被误当证据提交。
eval_results/ablation_latest.md

# ---------- 临时产物（调试/排查时容易产生，别带进仓库）----------
_pptmp/
runart/
*.tmp
pytest_out*.txt
run[0-9].txt
base_run*.txt

# ---------- IDE / OS ----------
.idea/
.vscode/
*.swp
*.swo
Thumbs.db
Desktop.ini
.DS_Store
