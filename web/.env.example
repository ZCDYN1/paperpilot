# =============================================================
# PaperPilot 前端配置 —— 复制为 .env.local 后按需修改
# 这里没有任何硬编码地址：改这几个值就能切换后端 / 演示模式
# =============================================================

# 1 = 使用内置 mock 数据，不需要启动 Python 后端即可浏览全部界面（演示 / 截图 / CI 用）
# 0 = 请求真实后端（走 VITE_PROXY_TARGET）
#
# 注意：`npm run build` 会额外读 `.env.production`，那份里默认是 0（真实后端）。
# 想构建一个纯演示用的包，在这里显式写 VITE_USE_MOCK=1 覆盖它。
VITE_USE_MOCK=0

# 开发期 Vite 把 /api 转发到哪个后端。换机器 / 换端口只改这一行。
VITE_PROXY_TARGET=http://127.0.0.1:8000

# 生产构建时前端 API 的基址。留空 = 与页面同源（由 FastAPI 单端口挂载，推荐）。
VITE_API_BASE=

# 应用标题（浏览器标签页 + 侧边栏 Logo 文案）
VITE_APP_TITLE=PaperPilot

# 部署到子路径时改这里，例如 /ui/
VITE_BASE_PATH=/

# 本地开发端口
VITE_DEV_PORT=5173
