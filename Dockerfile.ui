# =============================================================================
# PaperPilot Streamlit 面板镜像 ——【旧面板 / 调试入口】
# 产品界面现在是 api 镜像内置的 React 控制台（http://localhost:8000 同源直出）。
# 本镜像仅在 compose `--profile legacy-ui` 时构建/启动，用于对照原始 agent 输出、
# 排查后端问题；docker compose up 默认不会起它。
# UI 侧只依赖 streamlit + requests，不需要 torch / faiss，所以镜像可以做得很小
# =============================================================================
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN pip install --no-cache-dir "streamlit>=1.40" "requests>=2.32"

COPY ui/ ./ui/

EXPOSE 8501

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD python -c "import urllib.request,sys;sys.exit(0 if urllib.request.urlopen('http://localhost:8501/_stcore/health',timeout=3).status==200 else 1)"

CMD ["streamlit", "run", "ui/streamlit_app.py", \
     "--server.address=0.0.0.0", "--server.port=8501", "--server.headless=true"]
