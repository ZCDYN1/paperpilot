# =============================================================================
# PaperPilot 配置样例
# -----------------------------------------------------------------------------
# 用法：复制成 .env 再按需修改
#   最小可用（零成本跑通全链路）：把 LLM_PROVIDER 和 EMBEDDING_PROVIDER 都设成 mock
#   正常使用（推荐）：LLM_PROVIDER=openai，填好 OPENAI_BASE_URL / OPENAI_API_KEY / LLM_MODEL
# =============================================================================

# ------------------------------ LLM ------------------------------
# openai = 任何 OpenAI 兼容接口（OpenAI / DeepSeek / 通义 / 智谱 / 本地 vLLM / Ollama 的兼容端点）
# ollama = 直连本机 Ollama
# mock   = 不调用任何模型，返回预设结果，仅用于跑通流程与离线演示
LLM_PROVIDER=openai
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=sk-your-key-here
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=60

# ---------------------------- Ollama -----------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# -------------------------- Embedding ----------------------------
# local = 本地 BGE（需 `pip install -e ".[local]"`，首次运行自动下载权重）
# api   = 走 OpenAI 兼容的 /v1/embeddings
# mock  = 确定性伪向量，仅用于跑通流程
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
# 一次批量编码多少条文本。显存小 / API 有速率限制就调小（代价是变慢）。
EMBEDDING_BATCH_SIZE=16
# 仅当 EMBEDDING_PROVIDER=api 时生效
EMBEDDING_API_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_API_MODEL=text-embedding-3-small

# --------------------------- Reranker ----------------------------
# 关掉可显著降低延迟（代价是召回精度下降），消融实验会量化这个权衡
RERANK_ENABLED=true
# local = 真 BGE 交叉编码器（需装 [local] 依赖 + 约 2.3GB 权重）；lexical = 词面重叠降级，无需模型
# ⚠️ local 且权重不在本地时不会自动下载、不会崩：会降级为 lexical 并在日志里给出
#    可照抄的获取命令（含国内镜像 HF_ENDPOINT=https://hf-mirror.com）。
RERANK_PROVIDER=local
# 两种写法均可：HF 仓库名（如下）或本地目录（如 models/bge-reranker-v2-m3）
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ---------------------------- 检索 -------------------------------
RETRIEVE_TOP_K=50            # 每路（向量 / BM25）各召回多少条
RRF_K=60                     # RRF 平滑常数，越大越弱化头部名次差异
FUSE_TOP_N=30                # 融合后进入重排的候选数
RERANK_TOP_N=8               # 重排后每个子问题保留的论文数
# 真正送去精读（Reader 抽取）的论文数。默认与 RERANK_TOP_N 相同，但两者语义不同：
# 前者是"每个子问题留几篇候选"，后者是"整次研究抽几篇"。想压 token 成本就单独调它。
READ_TOP_K=8
MAX_CHUNKS_PER_PAPER=2       # 单篇论文最多贡献几个 chunk 进入重排
MIN_CORPUS=8                 # 语料命中数低于此值时进入「语料不足」降级分支

# ------------------------ 文档抓取（合规项）------------------------
# false = 完全关掉联网抓取分支，只用库里已有语料并如实声明覆盖度。
# README 的"只想确认链路通不通"零 key 命令用的就是它（配 mock provider，不联网不下模型）。
INGEST_ENABLED=true
# ⚠️ arXiv 官方要求声明式 User-Agent 且包含联系方式。
#    请把 you@example.com 换成你自己的邮箱，否则可能被限流。
ARXIV_USER_AGENT=PaperPilot/0.1 (mailto:you@example.com)
ARXIV_REQUEST_INTERVAL=3.0   # 请求间隔（秒），arXiv 限速要求 ≥3s
ARXIV_MAX_RESULTS=200        # 单次研究最多抓取的论文数
# 抓 arXiv 官方 HTML 正文（有章节结构，引用才能定位到具体章节）；取不到自动降级为摘要
FETCH_HTML=true
# 用 OpenAlex 补充被引数等数字字段（文本字段只信 arXiv 官方）
OPENALEX_ENABLED=true
# OpenAlex 的礼节性联系方式（会拼进它自己的 User-Agent）。
# 留空 = 自动从上面的 ARXIV_USER_AGENT 里抓 mailto，一般不用单独填。
OPENALEX_MAILTO=
OPENALEX_REQUEST_INTERVAL=0.2   # OpenAlex 没有 arXiv 那样硬的限速，但仍保持礼貌调用
# 所有外部 HTTP（arXiv API / HTML 页面 / embedding API）的超时秒数。
# arXiv 的 HTML 正文页较大，压太低会频繁超时并触发降级到摘要级证据。
HTTP_TIMEOUT=30

# ------------------------- 图 / 反思机制 --------------------------
MAX_REVISION=2               # 引用校验不通过时最多回退重试次数
CONFIRM_OUTLINE=false        # true = 开启「写作前确认大纲」中断点（会牺牲 3 分钟目标）

# ----------------------- 容错 / 熔断（三层保护）---------------------
# 顺序固定为「重试在最内 → 超时在中间 → 熔断在最外」，对外只表现为"失败就说失败，不假装成功"。
# resilience 关掉 = 三层全部旁路（LLM 调用直接透传）。默认开；
# 离线 / mock 场景**不需要**关它（mock 模型永不失败，断路器也就永远闭合）。
RESILIENCE_ENABLED=true
# 单次"带保护的调用"整体时间预算。⚠️ 必须 ≥ LLM_TIMEOUT × RESILIENCE_ATTEMPTS + 退避，
# 否则预算会在"第二次本来要成功"的那一次上掐死调用。默认 180 = 60s×2 + 退避余量。
RESILIENCE_TIMEOUT=180
RESILIENCE_ATTEMPTS=2
# 指数退避的乘数 / 上限 / 随机抖动上界（秒）。压测或 CI 可以三个都设 0 免等；
# 生产保持默认 —— 防惊群、防"把刚缓过来的下游再打趴"靠的就是这几秒。
RESILIENCE_BACKOFF=1.0
RESILIENCE_MAX_BACKOFF=8.0
RESILIENCE_JITTER=0.5
# 连续多少次"整段调用失败（内部重试用尽）"才打开熔断；打开后冷却多久放行一次半开试探
BREAKER_FAILURE_THRESHOLD=5
BREAKER_RECOVERY_TIMEOUT=60
# 对外 HTTP 出口（arXiv / OpenAlex / embedding API）是否也挂熔断
BREAKER_FOR_HTTP=true

# --------------------------- 输入侧防护 ----------------------------
# 用户可控文本（研究问题、编辑后的子问题）进图之前过 validate_input：
# 长度 / 控制字符 / 注入模式。关掉后代码仍会拦住控制字符与超长，只是不再拦注入模式。
INPUT_GUARD_ENABLED=true
# 单段用户文本的长度上限。⚠️ 它对 `question` 其实够不到：请求体 schema 先按
# max_length=2000 拦下（返回 422），闸门（400）只对 schema 没限死的那入口生效
# —— 比如 resume 时用户编辑过的子问题文本。两处错误结构也不同（422 是 pydantic 形状、
# 400 带 {code, hint}），前端要分开处理，别以为只有一个校验层。
INPUT_MAX_CHARS=4000
# reject  = 命中注入模式直接 400 拒绝（默认）
# degrade = 放行但使用清洗后的文本并打告警 —— 用户只是转述论文里一句像指令的原句时不误伤
INPUT_INJECTION_ACTION=reject

# --------------------- 追踪 / 评测（不填也能跑）--------------------
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=paperpilot
# LangSmith 端点；留空用官方默认端点（私有部署或自检时才改）
LANGCHAIN_ENDPOINT=

# ---------------------------- 存储 -------------------------------
# ★ 默认值已经锚在**仓库根**的绝对路径上（见 `app/core/config.py` 的 `REPO_ROOT`），
#   所以**这一段整段注释掉也能跑**，而且从任何目录启动都指向同一套库。
#   相对写法（`./data`）的坑是"在哪个目录启动就在哪新建一套空库"：不报错，
#   只是索引明明建了却什么都检索不到 —— 真要改，请改成绝对路径。
# 数据要放别的磁盘 / 容器里挂卷时，取消注释并填绝对路径：
# DATA_DIR=/absolute/path/to/data
# FAISS_INDEX_DIR=/absolute/path/to/data/faiss
# SQLITE_DIR=/absolute/path/to/data/sqlite
# CHECKPOINT_DB=/absolute/path/to/data/sqlite/checkpoints.db
# SQLITE_URL=sqlite+aiosqlite:////absolute/path/to/data/sqlite/paperpilot.db

# ---------------------------- 服务 -------------------------------
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# ----------------------------- UI --------------------------------
API_BASE=http://localhost:8000
