# =============================================================================
# PaperPilot 配置样例
# -----------------------------------------------------------------------------
# 用法：复制成 .env 再按需修改
#   最小可用（零成本跑通全链路）：把 LLM_PROVIDER 和 EMBEDDING_PROVIDER 都设成 mock
#   正常使用（推荐）：LLM_PROVIDER=openai，填好 OPENAI_BASE_URL / OPENAI_API_KEY / LLM_MODEL
# =============================================================================

# ------------------------------ LLM ------------------------------
# openai = 任何 OpenAI 兼容接口（OpenAI / DeepSeek / 通义 / 智谱 / 本地 vLLM / Ollama 的兼容端点）
# ollama = 直连本机 Ollama
# mock   = 不调用任何模型，返回预设结果，仅用于跑通流程与离线演示
LLM_PROVIDER=openai
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=sk-your-key-here
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=60

# ---------------------------- Ollama -----------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# -------------------------- Embedding ----------------------------
# local = 本地 BGE（需 `pip install -e ".[local]"`，首次运行自动下载权重）
# api   = 走 OpenAI 兼容的 /v1/embeddings
# mock  = 确定性伪向量，仅用于跑通流程
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
# 仅当 EMBEDDING_PROVIDER=api 时生效
EMBEDDING_API_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_API_MODEL=text-embedding-3-small

# --------------------------- Reranker ----------------------------
# 关掉可显著降低延迟（代价是召回精度下降），消融实验会量化这个权衡
RERANK_ENABLED=true
# local = 真 BGE 交叉编码器（需装 [local] 依赖）；lexical = 词面重叠降级，无需模型
RERANK_PROVIDER=local
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ---------------------------- 检索 -------------------------------
RETRIEVE_TOP_K=50            # 每路（向量 / BM25）各召回多少条
RRF_K=60                     # RRF 平滑常数，越大越弱化头部名次差异
FUSE_TOP_N=30                # 融合后进入重排的候选数
RERANK_TOP_N=8               # 重排后每个子问题保留的论文数
MAX_CHUNKS_PER_PAPER=2       # 单篇论文最多贡献几个 chunk 进入重排
MIN_CORPUS=8                 # 语料命中数低于此值时进入「语料不足」降级分支

# ------------------------ 文档抓取（合规项）------------------------
# ⚠️ arXiv 官方要求声明式 User-Agent 且包含联系方式。
#    请把 you@example.com 换成你自己的邮箱，否则可能被限流。
ARXIV_USER_AGENT=PaperPilot/0.1 (mailto:you@example.com)
ARXIV_REQUEST_INTERVAL=3.0   # 请求间隔（秒），arXiv 限速要求 ≥3s
ARXIV_MAX_RESULTS=200        # 单次研究最多抓取的论文数
# 抓 arXiv 官方 HTML 正文（有章节结构，引用才能定位到具体章节）；取不到自动降级为摘要
FETCH_HTML=true
# 用 OpenAlex 补充被引数等数字字段（文本字段只信 arXiv 官方）
OPENALEX_ENABLED=true

# ------------------------- 图 / 反思机制 --------------------------
MAX_REVISION=2               # 引用校验不通过时最多回退重试次数
CONFIRM_OUTLINE=false        # true = 开启「写作前确认大纲」中断点（会牺牲 3 分钟目标）

# --------------------- 追踪 / 评测（不填也能跑）--------------------
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=paperpilot

# ---------------------------- 存储 -------------------------------
DATA_DIR=./data
FAISS_INDEX_DIR=./data/faiss
SQLITE_DIR=./data/sqlite
CHECKPOINT_DB=./data/sqlite/checkpoints.db
SQLITE_URL=sqlite+aiosqlite:///./data/sqlite/paperpilot.db

# ---------------------------- 服务 -------------------------------
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# ----------------------------- UI --------------------------------
API_BASE=http://localhost:8000
